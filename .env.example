# Supabase (Project Settings -> API). Without these the site runs on built-in demo content
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (used for SEO, sitemap)
NEXT_PUBLIC_SITE_URL=https://dolfvisuals.com

# Optional: email notification for new bookings/inquiries via Resend (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=dolfvisuals@gmail.com

# Optional: AI answers in the website chat (otherwise the built-in FAQ assistant is used)
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5
